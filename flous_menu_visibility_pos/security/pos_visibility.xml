<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filter the POS dashboard and backend reads. System administrators are exempt. -->
    <record id="pos_config_visibility_rule" model="ir.access">
        <field name="name">Point of Sale visibility (Flous Flow)</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="operation">r</field>
        <field name="domain">[('restricted_user_ids', 'not in', user.id)] if not user.has_group('base.group_system') else [('id', '!=', False)]</field>
    </record>
</odoo>
