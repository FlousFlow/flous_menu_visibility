<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visibility_pos_config_list" model="ir.ui.view">
        <field name="name">pos.config.visibility.list</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <list string="Point of Sale Visibility" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                <field name="restricted_user_ids" widget="many2many_tags"
                       options="{'no_create': True, 'no_quick_create': True}"/>
            </list>
        </field>
    </record>

    <record id="view_visibility_pos_config_kanban" model="ir.ui.view">
        <field name="name">pos.config.visibility.kanban</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" delete="0">
                <templates>
                    <t t-name="card" class="d-flex flex-column gap-2">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="company_id" class="text-muted"
                               groups="base.group_multi_company"/>
                        <div>
                            <div class="text-muted small mb-1">Restricted users</div>
                            <field name="restricted_user_ids" widget="many2many_tags"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_visibility_pos_config_form" model="ir.ui.view">
        <field name="name">pos.config.visibility.form</field>
        <field name="model">pos.config</field>
        <field name="arch" type="xml">
            <form string="Point of Sale Visibility" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Point of Sale"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="restricted_user_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_quick_create': True}"
                               placeholder="Select users who must not see this point of sale..."/>
                    </group>
                    <div class="alert alert-info" role="status">
                        Select the internal users who must not see or start this point of sale.
                        System administrators always retain access.
                    </div>
                    <div class="alert alert-warning" role="status">
                        Close the active session before restricting this point of sale.
                        Existing sessions are never closed automatically.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_visibility_pos_config" model="ir.actions.act_window">
        <field name="name">Point of Sale Visibility</field>
        <field name="help"/>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="context">{'create': False}</field>
        <field name="domain">[]</field>
        <field name="view_id" ref="view_visibility_pos_config_list"/>
    </record>
    <record id="action_visibility_pos_config_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_visibility_pos_config_list"/>
        <field name="act_window_id" ref="action_visibility_pos_config"/>
    </record>
    <record id="action_visibility_pos_config_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_visibility_pos_config_kanban"/>
        <field name="act_window_id" ref="action_visibility_pos_config"/>
    </record>
    <record id="action_visibility_pos_config_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_visibility_pos_config_form"/>
        <field name="act_window_id" ref="action_visibility_pos_config"/>
    </record>

    <menuitem id="menu_visibility_pos_config"
              name="Point of Sale Visibility"
              parent="flous_menu_visibility.menu_visibility_control"
              action="action_visibility_pos_config"
              groups="base.group_system"
              sequence="50"/>
</odoo>
