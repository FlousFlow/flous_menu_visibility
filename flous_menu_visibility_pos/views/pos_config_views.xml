<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_visibility" model="ir.ui.view">
        <field name="name">pos.config.form.visibility</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Visibility" groups="base.group_system">
                    <field name="restricted_user_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_quick_create': True}"/>
                    <div class="alert alert-info" role="status">
                        Close the active session before restricting this point of sale.
                        Existing sessions are never closed automatically.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
