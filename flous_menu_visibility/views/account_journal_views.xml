<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_form_visibility" model="ir.ui.view">
        <field name="name">account.journal.form.visibility</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="before">
                <field name="visibility_mode"/>
            </xpath>
        </field>
    </record>
    <!-- Add a "Restricted Users" page on the journal form (admins only). -->
    <record id="view_account_journal_form_restricted_users" model="ir.ui.view">
        <field name="name">account.journal.form.restricted.users.flous</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="restricted_users" string="Restricted Users"
                      groups="base.group_system">
                    <field name="restricted_user_ids"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
