<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add a "Visible Users" page on the warehouse form (admins only). -->
    <record id="view_warehouse_visible_users" model="ir.ui.view">
        <field name="name">stock.warehouse.form.visible.users.flous</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="visible_users" string="Visible Users"
                      groups="base.group_system">
                    <list>
                        <field name="visible_user_ids"/>
                    </list>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
