<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="visibility_picker_form" model="ir.ui.view">
        <field name="name">flous.visibility.picker.form</field>
        <field name="model">flous.visibility.picker</field>
        <field name="arch" type="xml">
            <form string="Hide Item from Users">
                <group>
                    <field name="target_type" invisible="1"/>
                    <field name="model_id" invisible="1"/>
                    <field name="field_id" invisible="1"/>
                    <field name="menu_id" invisible="1"/>
                    <field name="journal_id" invisible="1"/>
                    <field name="button_name" invisible="1"/>
                    <field name="button_type" invisible="1"/>
                    <field name="button_id" invisible="1"/>
                    <field name="button_field_name" invisible="1"/>
                    <field name="button_hotkey" invisible="1"/>
                    <field name="button_selector_key" invisible="1"/>
                    <field name="button_label" invisible="1"/>
                    <field name="eligible_user_ids" invisible="1"/>
                    <field name="target_label" string="Item to Hide" readonly="1"/>
                    <div class="alert alert-info" role="status">
                        Choose the internal users who should not see this item.
                        Search by name in the user field. System administrators are
                        always excluded from visibility restrictions.
                    </div>
                    <field name="user_ids" widget="many2many_tags"
                           placeholder="Search internal users..."
                           options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}"/>
                    <field name="selected_user_count" readonly="1"/>
                    <div class="d-flex gap-2">
                        <button name="action_select_all_users" type="object"
                                string="Select All Internal Users" class="btn-secondary"/>
                        <button name="action_clear_users" type="object"
                                string="Clear Selection" class="btn-secondary"/>
                    </div>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
