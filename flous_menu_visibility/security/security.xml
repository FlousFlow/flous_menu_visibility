<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_warehouse_visibility" model="res.groups.privilege">
        <field name="name">Warehouse Visibility</field>
        <field name="sequence">31</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_warehouse_visibility" model="res.groups">
        <field name="name">Warehouse Visibility</field>
        <field name="privilege_id" ref="res_groups_privilege_warehouse_visibility"/>
        <field name="sequence">10</field>
    </record>

    <!-- Odoo 20 replaces ir.rule with ir.access. These global restrictions
         preserve the old read-only warehouse visibility behavior while the
         conditional domain leaves non-members and administrators unrestricted. -->
    <record id="picking_warehouse_visibility_rule" model="ir.access">
        <field name="name">Picking warehouse visibility (Flous Flow)</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="operation">r</field>
        <field name="domain">[('picking_type_id.warehouse_id', 'in', user.visible_warehouse_ids.ids)] if user.has_group('flous_menu_visibility.group_warehouse_visibility') and not user.has_group('base.group_system') else [('id', '!=', False)]</field>
    </record>

    <record id="move_warehouse_visibility_rule" model="ir.access">
        <field name="name">Move warehouse visibility (Flous Flow)</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="operation">r</field>
        <field name="domain">[('picking_id.picking_type_id.warehouse_id', 'in', user.visible_warehouse_ids.ids)] if user.has_group('flous_menu_visibility.group_warehouse_visibility') and not user.has_group('base.group_system') else [('id', '!=', False)]</field>
    </record>

    <record id="move_line_warehouse_visibility_rule" model="ir.access">
        <field name="name">Move line warehouse visibility (Flous Flow)</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="operation">r</field>
        <field name="domain">[('picking_id.picking_type_id.warehouse_id', 'in', user.visible_warehouse_ids.ids)] if user.has_group('flous_menu_visibility.group_warehouse_visibility') and not user.has_group('base.group_system') else [('id', '!=', False)]</field>
    </record>
</odoo>
