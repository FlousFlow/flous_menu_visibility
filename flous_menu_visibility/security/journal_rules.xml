<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="journal_visibility_rule" model="ir.rule">
        <field name="name">Journal visibility (Flous Flow)</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">['|', ('restricted_user_ids', '=', False), ('restricted_user_ids', 'not in', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="move_visibility_rule" model="ir.rule">
        <field name="name">Move visibility (Flous Flow)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">['|', ('journal_id.restricted_user_ids', '=', False), ('journal_id.restricted_user_ids', 'not in', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="move_line_visibility_rule" model="ir.rule">
        <field name="name">Move line visibility (Flous Flow)</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">['|', ('move_id.journal_id.restricted_user_ids', '=', False), ('move_id.journal_id.restricted_user_ids', 'not in', user.id)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
